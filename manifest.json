{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.8.0",
  "default_locale": "en",
  "description": "__MSG_extDescription__",
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "offscreen"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "options_page": "options.html",
  "action": {
    "default_popup": "popup.html",
    "default_title": "语音问卷助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.wjx.cn/*",
        "*://*.wjx.top/*",
        "*://*.sojump.com/*",
        "*://docs.google.com/forms/*",
        "*://*.jinshuju.net/*",
        "*://*.jinshuju.com/*",
        "*://*.wj.qq.com/*",
        "*://wenjuan.meituan.com/*"
      ],
      "js": [
        "src/shared/settings.js",
        "src/content/canonical.js",
        "src/content/adapters/registry.js",
        "src/content/adapters/wjx.js",
        "src/content/adapters/google-forms.js",
        "src/content/adapters/generic.js",
        "src/content/core/matcher.js",
        "src/content/core/tts.js",
        "src/content/core/focus.js",
        "src/content/core/asr.js",
        "src/content/core/recorder.js",
        "src/content/core/llm.js",
        "src/content/core/voice-engine.js",
        "ui/panel.js",
        "src/content/main.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}